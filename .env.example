# Defaults for local development. Never use demo database credentials in production.
SERVER_ADDR=127.0.0.1:8085
RUST_LOG=grenadiers_server=info,tower_http=info
ALLOWED_ORIGINS=http://localhost:5177,http://127.0.0.1:5177,http://localhost:8085,http://127.0.0.1:8085
# Optional: leave unset for the transport scaffold (no persistence required).
# DATABASE_URL=postgres://grenadiers:grenadiers_local_only@127.0.0.1:5436/grenadiers
# WEB_DIST_DIR=web/dist
# Optional isolated round reproduction: read once, strict 64 lowercase hex + optional LF.
# Leave unset for fresh OS randomness per actual round; changing the file requires restart.
# GAME_ROUND_SEED_FILE=/absolute/path/to/round.seed
