{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grenadiers.example/schemas/cpu-debug-v1.json",
  "title": "CPU intent diagnostics protocol version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "roomId", "roundId", "tick", "revision", "youSeat", "cpus"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "roomId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "roundId": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "tick": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "youSeat": { "$ref": "#/$defs/seat" },
    "cpus": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/cpuRow" } }
  },
  "$defs": {
    "seat": { "type": "string", "enum": ["one", "two", "three", "four"] },
    "cell": {
      "type": "object", "additionalProperties": false, "required": ["column", "row"],
      "properties": {
        "column": { "type": "integer", "minimum": 0, "maximum": 14 },
        "row": { "type": "integer", "minimum": 0, "maximum": 12 }
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type", "cell", "kind"],
          "properties": {
            "type": { "const": "pickup" }, "cell": { "$ref": "#/$defs/cell" },
            "kind": { "type": "string", "enum": ["bombCapacity", "blastRange", "movementSpeed", "kick", "punch", "bracelet", "wallPass", "heart", "remoteBomb", "piercingBomb", "powerBomb", "landmine", "shield", "stopwatch", "invisibilityCloak", "goldenFlame", "shortFuse", "diarrhea", "slowFoot", "shortFlame", "longFuse", "reverseControls", "invisibleBombs", "oilBarrel", "teleporter"] }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "cell"],
          "properties": { "type": { "enum": ["block", "tile"] }, "cell": { "$ref": "#/$defs/cell" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "seat"],
          "properties": { "type": { "const": "opponent" }, "seat": { "$ref": "#/$defs/seat" } }
        }
      ]
    },
    "cpuRow": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["seat", "status"],
          "properties": { "seat": { "$ref": "#/$defs/seat" }, "status": { "const": "unavailable" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["seat", "status", "observedTick", "objective", "target", "approach", "phase", "switchReason"],
          "properties": {
            "seat": { "$ref": "#/$defs/seat" }, "status": { "const": "available" },
            "observedTick": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "objective": { "type": "string", "enum": ["collect", "farm", "attack", "explore", "survive", "wait"] },
            "target": { "anyOf": [{ "$ref": "#/$defs/target" }, { "type": "null" }] },
            "approach": { "anyOf": [{ "$ref": "#/$defs/cell" }, { "type": "null" }] },
            "phase": { "type": "string", "enum": ["approach", "plant", "escape", "reengage", "evade", "waiting"] },
            "switchReason": { "type": "string", "enum": ["initial", "completed", "targetInvalid", "visibilityLost", "betterOpportunity", "stalled", "noTargets", "safetyInterrupt", "resumed"] }
          }
        }
      ]
    }
  }
}
