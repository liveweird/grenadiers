{
  "openapi": "3.0.3",
  "info": {
    "title": "Grenadiers HTTP API",
    "version": "0.1.0",
    "description": "HTTP health, diagnostics, and anonymous gameplay session issuance.",
    "contact": {
      "name": "Grenadiers contributors"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8085",
      "description": "Local development"
    }
  ],
  "security": [],
  "x-api-fallback-responses": {
    "description": "Responses for requests that do not match a documented operation.",
    "404": {
      "$ref": "#/components/responses/NotFound"
    },
    "405": {
      "$ref": "#/components/responses/MethodNotAllowed"
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Liveness and readiness probes"
    },
    {
      "name": "realtime",
      "description": "Diagnostic WebSocket transport"
    },
    {
      "name": "game",
      "description": "Anonymous gameplay session transport"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check process liveness",
        "description": "Independent of optional PostgreSQL availability.",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "Process is alive",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ready": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Check required dependencies",
        "description": "With no DATABASE_URL the database is optional. With it set, readiness requires a successful database query.",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "Ready to accept traffic",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "503": {
            "description": "Configured PostgreSQL is unavailable",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/game/session": {
      "post": {
        "operationId": "createGameSession",
        "summary": "Create an anonymous gameplay session",
        "description": "Issues a gameplay credential that expires if unclaimed after 300 seconds. Browser Origin must exactly match the configured allowlist. Credentials must remain outside URLs and logs; query parameters are rejected.",
        "tags": [
          "game"
        ],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "description": "Exact browser origin from ALLOWED_ORIGINS.",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Anonymous gameplay session created",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameSession"
                }
              }
            }
          },
          "400": {
            "description": "Query parameters are not supported",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing or disallowed Origin",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Global session issuance rate exceeded",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Session registry capacity exhausted or credential generation unavailable",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/game/ws": {
      "get": {
        "operationId": "connectGame",
        "summary": "Connect an authenticated gameplay WebSocket",
        "description": "Upgrades to the gameplay protocol. The first application frame must authenticate with a credential created by POST /api/v1/game/session. Credentials are never accepted in URLs.",
        "tags": [
          "game"
        ],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "description": "Exact non-null browser origin from ALLOWED_ORIGINS.",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "Switching protocols; client must send an authenticate frame first.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            }
          },
          "400": {
            "description": "Query parameters are unsupported or the WebSocket handshake is malformed.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Missing, duplicated, null, malformed, or disallowed Origin",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Global gameplay connection rate exceeded",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Shared WebSocket connection capacity exhausted",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ws": {
      "get": {
        "operationId": "connectRealtime",
        "summary": "Upgrade to the version 1 diagnostic WebSocket",
        "description": "Browser Origin must match the configured allowlist. Messages follow api/realtime.schema.json; this scaffold does not create rooms or reserve player seats. Invalid upgrades are rejected by Axum.",
        "tags": [
          "realtime"
        ],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "description": "Exact browser origin from ALLOWED_ORIGINS.",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "Switching protocols; server sends a welcome message.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            }
          },
          "400": {
            "description": "Malformed WebSocket handshake; framework-generated rejection (plain text).",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Missing or disallowed Origin",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Diagnostic WebSocket upgrade rate exceeded",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Diagnostic WebSocket connection capacity exhausted or server shutdown in progress",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "headers": {
      "NoStore": {
        "description": "Prevents storage of the response by caches.",
        "schema": {
          "type": "string",
          "enum": [
            "no-store"
          ]
        },
        "example": "no-store"
      },
      "RetryAfter": {
        "description": "Minimum delay in seconds before retrying.",
        "schema": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "example": "1"
      }
    },
    "responses": {
      "NotFound": {
        "description": "No API route matches the requested path.",
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "about:blank",
              "title": "Not Found",
              "status": 404,
              "detail": "API route does not exist"
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "The API path exists but does not support the requested method.",
        "headers": {
          "Allow": {
            "description": "Methods supported by the matched API route.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "about:blank",
              "title": "Method Not Allowed",
              "status": 405,
              "detail": "HTTP method is not supported for this API route"
            }
          }
        }
      }
    },
    "schemas": {
      "GameSession": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "Status": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
