@@ -0,0 +1,190 @@
+use std::sync::Arc;
+
+use grenadiers_core::game::{Direction, Position, SeatId, Tick};
+use tokio::{sync::watch, time::Instant};
+
+use super::{RosterOwnerNotice, driver::Driver, refuge_handoff_physical_support};
+use crate::game::rooms::{RandomFill, roster_runtime::RosterAction};
+
+pub(super) const CPU: SeatId = SeatId::Two;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Admission {
+    Held,
+    Accepted,
+    Refused,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Renewal {
+    Accepted,
+    EarlyRevoked,
+    InvalidRevoked,
+}
+
+/// Test-only timing model for the proposed recovery checkpoint contract.
+///
+/// A grant here is synthetic scheduling authority, never a Core safety
+/// certificate. The tracker deliberately has no mailbox-TTL fallback.
+pub(super) struct GrantTracker {
+    basis: Tick,
+    direction: Direction,
+    active: bool,
+    report_due: Option<Tick>,
+    valid_through: Option<Tick>,
+}
+
+impl GrantTracker {
+    pub(super) const fn new(basis: Tick, direction: Direction) -> Self {
+        Self {
+            basis,
+            direction,
+            active: false,
+            report_due: None,
+            valid_through: None,
+        }
+    }
+
+    pub(super) fn admit(&mut self, episode: &mut Episode) -> Admission {
+        let publication = episode.publication_tick();
+        let exact = Tick(self.basis.0 + 6);
+        if publication < exact {
+            return Admission::Held;
+        }
+        if publication > exact || self.active {
+            return Admission::Refused;
+        }
+        self.active = true;
+        self.report_due = Some(Tick(self.basis.0 + 9));
+        self.valid_through = Some(Tick(self.basis.0 + 9));
+        episode.submit(Some(self.direction));
+        Admission::Accepted
+    }
+
+    pub(super) fn renew(&mut self, episode: &mut Episode, direction: Direction) -> Renewal {
+        let publication = episode.publication_tick();
+        let due = self.report_due.expect("admitted grant has a report phase");
+        if publication < due {
+            self.revoke(episode);
+            self.report_due = Some(Tick(publication.0 + 3));
+            return Renewal::EarlyRevoked;
+        }
+        if publication != due || direction != self.direction {
+            self.revoke(episode);
+            return Renewal::InvalidRevoked;
+        }
+        self.report_due = Some(Tick(publication.0 + 3));
+        self.valid_through = Some(Tick(publication.0 + 3));
+        episode.submit(Some(direction));
+        Renewal::Accepted
+    }
+
+    pub(super) fn stop_if_unrenewed(&mut self, episode: &mut Episode) {
+        if self.active && self.report_due == Some(episode.publication_tick()) {
+            self.revoke(episode);
+        }
+    }
+
+    fn revoke(&mut self, episode: &mut Episode) {
+        self.active = false;
+        self.valid_through = None;
+        episode.submit(None);
+    }
+
+    pub(super) const fn report_due(&self) -> Option<Tick> {
+        self.report_due
+    }
+
+    pub(super) const fn valid_through(&self) -> Option<Tick> {
+        self.valid_through
+    }
+}
+
+pub(super) struct Episode {
+    driver: Driver,
+}
+
+impl Episode {
+    pub(super) fn new() -> Self {
+        let (mut runtime, state) = refuge_handoff_physical_support::running_runtime_and_scene();
+        let notice = runtime.install_running_scene_for_test(state).unwrap();
+        let (notices, receiver) = watch::channel(RosterOwnerNotice::Publication(notice.clone()));
+        drop(receiver);
+        let random_fill: Arc<RandomFill> = Arc::new(|bytes| {
+            bytes.fill(42);
+            Ok(())
+        });
+        let mut driver = Driver::new(
+            runtime,
+            notice.clone(),
+            notices,
+            Instant::now() + std::time::Duration::from_secs(300),
+            random_fill,
+            Vec::new(),
+        );
+        driver.publish(notice);
+        Self { driver }
+    }
+
+    pub(super) fn publication_tick(&self) -> Tick {
+        let wire = self.driver.last.spike_v19_room().unwrap().tick.get();
+        Tick(wire)
+    }
+
+    pub(super) fn boundary_tick(&self) -> Tick {
+        self.driver.runtime.lifecycle().tick()
+    }
+
+    pub(super) fn tick(&mut self) {
+        self.driver.tick(Instant::now()).unwrap();
+    }
+
+    pub(super) fn advance_boundary_to(&mut self, target: Tick) {
+        while self.boundary_tick() < target {
+            self.tick();
+        }
+        assert_eq!(self.boundary_tick(), target);
+    }
+
+    pub(super) fn publish_current_early(&mut self) {
+        let notice = self.driver.runtime.current_notice().unwrap();
+        self.driver.publish(notice);
+        assert_eq!(self.publication_tick(), self.boundary_tick());
+    }
+
+    pub(super) fn pending_reports(&self) -> usize {
+        self.driver.runtime.pending_report_count_for_test()
+    }
+
+    pub(super) fn submit(&mut self, direction: Option<Direction>) {
+        self.driver
+            .runtime
+            .submit_cpu_intent(
+                CPU,
+                self.driver.runtime.lifecycle().round_attempt(),
+                RosterAction::Movement(direction),
+            )
+            .unwrap();
+    }
+
+    pub(super) fn position(&self) -> Position {
+        self.driver
+            .runtime
+            .state_for_test()
+            .unwrap()
+            .actor(CPU)
+            .unwrap()
+            .position()
+    }
+
+    pub(super) fn motion(&self) -> (Position, Direction) {
+        let actor = self
+            .driver
+            .runtime
+            .state_for_test()
+            .unwrap()
+            .actor(CPU)
+            .unwrap();
+        (actor.position(), actor.heading())
+    }
+}
