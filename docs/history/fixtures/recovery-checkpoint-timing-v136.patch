@@ -0,0 +1,141 @@
+use grenadiers_core::game::{Direction, Tick};
+
+use super::recovery_checkpoint_timing_support::{Admission, Episode, GrantTracker, Renewal};
+
+fn tick_after(basis: Tick, offset: u64) -> Tick {
+    Tick(basis.0 + offset)
+}
+
+fn admitted() -> (Episode, GrantTracker, Tick) {
+    let mut episode = Episode::new();
+    let basis = episode.publication_tick();
+    let mut tracker = GrantTracker::new(basis, Direction::East);
+    episode.advance_boundary_to(tick_after(basis, 6));
+    assert_eq!(episode.publication_tick(), tick_after(basis, 6));
+    assert_eq!(tracker.admit(&mut episode), Admission::Accepted);
+    assert_eq!(tracker.valid_through(), Some(tick_after(basis, 9)));
+    (episode, tracker, basis)
+}
+
+#[test]
+fn admission_is_held_before_b_plus_six_and_refused_after_it() {
+    let mut exact = Episode::new();
+    let basis = exact.publication_tick();
+    let mut tracker = GrantTracker::new(basis, Direction::East);
+    exact.advance_boundary_to(tick_after(basis, 3));
+    assert_eq!(exact.publication_tick(), tick_after(basis, 3));
+    assert_eq!(tracker.admit(&mut exact), Admission::Held);
+    assert_eq!(exact.position(), Episode::new().position());
+    exact.advance_boundary_to(tick_after(basis, 6));
+    assert_eq!(exact.publication_tick(), tick_after(basis, 6));
+    assert_eq!(tracker.admit(&mut exact), Admission::Accepted);
+
+    let mut late = Episode::new();
+    let late_basis = late.publication_tick();
+    let mut late_tracker = GrantTracker::new(late_basis, Direction::East);
+    late.advance_boundary_to(tick_after(late_basis, 9));
+    assert_eq!(late.publication_tick(), tick_after(late_basis, 9));
+    assert_eq!(late_tracker.admit(&mut late), Admission::Refused);
+}
+
+#[test]
+fn exact_grant_moves_b_plus_seven_through_nine() {
+    let (mut episode, _tracker, basis) = admitted();
+    let mut prior = episode.position();
+    for offset in 7..=9 {
+        episode.tick();
+        assert_eq!(episode.boundary_tick(), tick_after(basis, offset));
+        let current = episode.position();
+        assert_ne!(current, prior, "grant did not move on update b+{offset}");
+        prior = current;
+    }
+    assert_eq!(episode.publication_tick(), tick_after(basis, 9));
+}
+
+#[test]
+fn b_plus_nine_refresh_is_observed_before_service_and_preserves_motion() {
+    let (mut renewed, mut tracker, basis) = admitted();
+    let mut baseline = Episode::new();
+    baseline.advance_boundary_to(tick_after(basis, 6));
+    baseline.submit(Some(Direction::East));
+
+    for offset in 7..=9 {
+        renewed.tick();
+        baseline.tick();
+        assert_eq!(
+            renewed.motion(),
+            baseline.motion(),
+            "diverged at b+{offset}"
+        );
+    }
+    assert_eq!(renewed.publication_tick(), tick_after(basis, 9));
+    let at_nine = renewed.position();
+    assert_eq!(
+        tracker.renew(&mut renewed, Direction::East),
+        Renewal::Accepted
+    );
+    assert_eq!(tracker.valid_through(), Some(tick_after(basis, 12)));
+
+    // The unchanged-direction refresh is submitted after observing publication
+    // b+9 and before Driver::tick services physical update b+10.
+    renewed.tick();
+    baseline.tick();
+    assert_eq!(renewed.boundary_tick(), tick_after(basis, 10));
+    assert_eq!(renewed.publication_tick(), tick_after(basis, 9));
+    assert_ne!(renewed.position(), at_nine);
+    assert_eq!(renewed.motion(), baseline.motion());
+}
+
+#[test]
+fn missing_or_invalid_renewal_stops_the_first_unauthorized_update() {
+    let (mut missing, mut missing_tracker, basis) = admitted();
+    missing.advance_boundary_to(tick_after(basis, 9));
+    let missing_last = missing.position();
+    missing_tracker.stop_if_unrenewed(&mut missing);
+    missing.tick();
+    assert_eq!(missing.boundary_tick(), tick_after(basis, 10));
+    assert_eq!(missing.publication_tick(), tick_after(basis, 9));
+    assert_eq!(missing.position(), missing_last);
+
+    let (mut invalid, mut invalid_tracker, invalid_basis) = admitted();
+    invalid.advance_boundary_to(tick_after(invalid_basis, 9));
+    let invalid_last = invalid.position();
+    assert_eq!(
+        invalid_tracker.renew(&mut invalid, Direction::North),
+        Renewal::InvalidRevoked
+    );
+    invalid.tick();
+    assert_eq!(invalid.boundary_tick(), tick_after(invalid_basis, 10));
+    assert_eq!(invalid.publication_tick(), tick_after(invalid_basis, 9));
+    assert_eq!(invalid.position(), invalid_last);
+}
+
+#[test]
+fn actual_early_publication_resets_report_phase_and_revokes() {
+    for moves in [1, 2] {
+        let (mut episode, mut tracker, basis) = admitted();
+        let at_admission = episode.position();
+        episode.advance_boundary_to(tick_after(basis, 6 + moves));
+        assert_ne!(episode.position(), at_admission);
+        assert_eq!(episode.publication_tick(), tick_after(basis, 6));
+        assert_eq!(episode.pending_reports(), moves as usize);
+        episode.publish_current_early();
+        assert_eq!(episode.pending_reports(), 0);
+        let early = episode.publication_tick();
+        assert_eq!(early, tick_after(basis, 6 + moves));
+        assert_eq!(
+            tracker.renew(&mut episode, Direction::East),
+            Renewal::EarlyRevoked
+        );
+        assert_eq!(tracker.report_due(), Some(Tick(early.0 + 3)));
+        assert_eq!(tracker.valid_through(), None);
+        let stopped = episode.position();
+        episode.tick();
+        assert_eq!(episode.position(), stopped);
+    }
+}
+
+// These tests exercise only real owner/runtime publication order and physical
+// input persistence. Synthetic grants are not safety certificates. They do not
+// prove conditional trajectories, safe Stop suffixes, teleport/contact handling,
+// pending-turn assistance, or integration with a production CPU recovery path.
