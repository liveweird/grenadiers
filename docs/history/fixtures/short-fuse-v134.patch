+  for _ in 0..500 {
+   let report=planner.pump_for_test(usize::MAX);assert_eq!(report.failed,0);max_work=max_work.max(report.work.into_iter().max().unwrap_or(0));
+   owner.tick(Instant::now()).unwrap();let state=owner.runtime.state_for_test().unwrap();
+   for bomb in state.world().bombs().values() {if !births.iter().any(|x:&(u32,Tick,Tick)|x.0==bomb.id().0) {
