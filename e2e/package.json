{
  "name": "grenadiers-e2e",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Browser black-box tests against the complete Grenadiers stack",
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:pickups": "playwright test --config playwright.pickups.config.ts",
    "test:heart": "playwright test --config playwright.heart.config.ts",
    "test:shield": "playwright test --config playwright.shield.config.ts",
    "test:controls": "playwright test --config playwright.controls.config.ts",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "install:browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "check:scenarios": "node --test scripts/scenario-contract.test.mjs && node scripts/check-scenarios.mjs && npm run check:live-pixel-window && npm run check:visibility-startup && npm run check:kick-timeline",
    "check:live-pixel-window": "node --experimental-strip-types invisible-bombs-tests/live-pixel-window.check.ts",
    "check:visibility-startup": "node --experimental-strip-types tests/support/visibility-startup.check.ts",
    "check:kick-timeline": "node --experimental-strip-types kick-tests/kick-timeline.check.ts",
    "lint": "eslint . --max-warnings 0",
    "knip": "knip",
    "test:matches": "playwright test --config playwright.matches.config.ts",
    "test:reconnect": "playwright test --config playwright.reconnect.config.ts",
    "test:hardening": "playwright test --config playwright.hardening.config.ts",
    "test:latency": "playwright test --config playwright.latency.config.ts",
    "test:audio": "playwright test --config playwright.audio.config.ts",
    "test:golden-flame": "playwright test --config playwright.golden-flame.config.ts",
    "test:short-fuse": "playwright test --config playwright.short-fuse.config.ts",
    "test:short-flame": "playwright test --config playwright.short-flame.config.ts",
    "test:long-fuse": "playwright test --config playwright.long-fuse.config.ts",
    "test:reverse-controls": "playwright test --config playwright.reverse-controls.config.ts",
    "test:diarrhea": "playwright test --config playwright.diarrhea.config.ts",
    "test:slow-foot": "playwright test --config playwright.slow-foot.config.ts",
    "test:piercing-bomb": "playwright test --config playwright.piercing-bomb.config.ts",
    "test:power-bomb": "playwright test --config playwright.power-bomb.config.ts",
    "test:remote-bomb": "playwright test --config playwright.remote-bomb.config.ts",
    "test:landmine": "playwright test --config playwright.landmine.config.ts",
    "test:invisibility-cloak": "playwright test --config playwright.invisibility-cloak.config.ts",
    "test:stopwatch": "playwright test --config playwright.stopwatch.config.ts",
    "test:invisible-bombs": "playwright test --config playwright.invisible-bombs.config.ts",
    "test:teleporter": "playwright test --config playwright.teleporter.config.ts",
    "test:wall-pass": "playwright test --config playwright.wall-pass.config.ts",
    "test:kick": "playwright test --config playwright.kick.config.ts",
    "test:punch": "playwright test --config playwright.punch.config.ts",
    "test:bracelet": "playwright test --config playwright.bracelet.config.ts",
    "test:oil-barrel": "playwright test --config playwright.oil-barrel.config.ts",
    "test:renderer-diagnostics": "playwright test --config playwright.renderer-diagnostics.config.ts",
    "test:terrain-pixels": "playwright test --config playwright.terrain-pixels.config.ts",
    "art:template": "node scripts/art-atlas-cli.mjs template",
    "art:export": "node scripts/art-atlas-cli.mjs export",
    "test:art-atlas": "playwright test --config playwright.art-atlas.config.ts",
    "test:atlas-gameplay": "playwright test --config playwright.atlas-gameplay.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-plugin-sonarjs": "4.2.1",
    "globals": "17.12.0",
    "knip": "6.38.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
