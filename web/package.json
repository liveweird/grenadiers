{
  "name": "grenadiers-web",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "lint": "eslint . --max-warnings 0",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gen:api": "openapi-typescript ../api/openapi.json -o src/api/schema.ts",
    "check:api": "node scripts/check-api.mjs",
    "lint:api": "vitest run scripts/lint-api.test.mjs scripts/api-conventions.test.mjs && node scripts/lint-api.mjs",
    "gen:realtime": "node scripts/generate-realtime.mjs",
    "check:realtime": "node scripts/check-realtime.mjs",
    "gen:gameplay": "node scripts/generate-gameplay.mjs",
    "check:gameplay": "node scripts/check-gameplay.mjs",
    "build:renderer-diagnostics": "tsc --project tsconfig.renderer-diagnostics.json && vite build --config vite.renderer-diagnostics.config.ts",
    "preview:renderer-diagnostics": "vite preview --config vite.renderer-diagnostics.config.ts --host 0.0.0.0 --port 5188 --strictPort",
    "preview:art-atlas": "vite preview --config vite.renderer-diagnostics.config.ts --host 127.0.0.1 --port 5188 --strictPort --open /art-atlas.html",
    "serve:art-atlas-test": "npm run build:renderer-diagnostics && npm run preview:renderer-diagnostics"
  },
  "dependencies": {
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "ajv": "8.20.0",
    "i18next": "26.5.5",
    "i18next-browser-languagedetector": "8.2.1",
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stoplight/spectral-core": "1.24.0",
    "@stoplight/spectral-parsers": "1.0.5",
    "@stoplight/spectral-ruleset-bundler": "1.8.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "knip": "6.42.1",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.31",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "overrides": {
    "react-is": "19.3.0"
  }
}
